import ./pather as pather
recipe pather.makeJsonRecipePath('lock') {
  "type": "minecraft:crafting_shapeless",
  "category": "misc",
  "ingredients": [
    "minecraft:iron_nugget",
    "minecraft:gold_ingot",
    "minecraft:string"
  ],
  "result": {
    "id": "minecraft:gold_nugget",
    "components": {
      "minecraft:item_model": pather.makeItemModelPath('lock'),
      "minecraft:custom_model_data": {},
      "minecraft:custom_data": {
        "ulg": {
          "item_id": "bp/lock"
        }
      },
      "minecraft:item_name": {
        "translate": "ulg.item.backpack.lock",
        "fallback": "Lock",
        "color": "gold",
        "italic": false
      }
    },
    "count": 1
  }
}

# .components."minecraft:custom_data".ulg.item_id == "bp/lock"

item_model (pather.makeItemModelPath('lock')) {
  "model": {
    "type": "minecraft:model",
    "model": pather.makeJsonModelsPath('lock')
  }
}

model pather.makeJsonModelsPath('lock') {
  "parent": "minecraft:item/generated",
  "textures": {
    "layer0": "ulg_bp/item/lock"
  }
}