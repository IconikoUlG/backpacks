from bolt_expressions import Scoreboard, Data
from @util/builders import wrap, get_wrapped_name

def hasOwner(bpItem): # not working due to bolt expressions
    if bpItem.components."minecraft:custom_data".bp.Owner:
        return true
    return false

from @jsons import LT_drop_head
from mecha import Mecha
mc = ctx.inject(Mecha)
def setOwner(bpItem,playerData,playerSel):
    bpItem.components."minecraft:custom_data".bp.Owner = playerData.UUID
    as mc.parse(playerData._target, using="selector") positioned ~ -65 ~:
        loot spawn ~ ~ ~ loot (LT_drop_head())  # Item.components."minecraft:profile".name
    lore = Data.storage(ulg:macro).tick.lock.ownerLore
    lore = {
      "translate": "ulg.lore.owner",
      "fallback": "Owner: %s","with":[],"color": "#B1B3B3","italic": false
    }
    function (~/m_inject_pname):
      $data modify storage ulg:macro tick.lock.ownerLore.with set value ['$(name)']
    function (~/m_inject_pname) with entity @n[type=item,nbt={Item:{components:{"minecraft:custom_data":{ulg:{id:"intick"}}}}}] Item.components."minecraft:profile"
    bpItem.components."minecraft:lore".append(lore)
    # set first row of the lore to "Owner: <Player Name>"
    kill @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{ulg:{id:"intick"}}}}}]

def checkOwner(bpItem,playerData):
    result = Data.storage(ulg:macro).tick.lock.checkOwner
    result = false
    if (bpItem.components."minecraft:custom_data".bp.Owner == playerData.UUID):
        result = true
    if not bpItem.components."minecraft:custom_data".bp.Owner:
        result = true
    return result

